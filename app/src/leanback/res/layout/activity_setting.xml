<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_page">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 三列结构：左列 9 项 | 中间图片位 | 右列 9 项 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 左列 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/vod"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_vod"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vodUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:ellipsize="middle"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="https://" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/vodHome"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_cell_icon"
                        android:duplicateParentState="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_setting_home"
                        android:tint="@color/cell_icon_csl" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/vodHistory"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_cell_icon"
                        android:duplicateParentState="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_setting_history"
                        android:tint="@color/cell_icon_csl" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/wall"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_wall"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/wallUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:ellipsize="middle"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="https://" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/wallDefault"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_cell_icon"
                        android:duplicateParentState="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_setting_home"
                        android:tint="@color/cell_icon_csl" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/wallRefresh"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_cell_icon"
                        android:duplicateParentState="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_setting_refresh"
                        android:tint="@color/cell_icon_csl" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/danmaku"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_danmaku"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="设置"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/home"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_home"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="设置"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/size"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_size"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sizeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="中" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/doh"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_doh"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/dohText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.5"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="Google" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/backup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="数据备份"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="@string/setting_backup"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sync"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_sync"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="WebDAV"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/reload"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="重载配置"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="刷新"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 中间动图位：钟表 + 月历（透明底，直接透出外层 bg_page 的紫色渐变，不做成卡片） -->
            <com.fongmi.android.tv.ui.custom.StarFlowView
                android:id="@+id/centerPoster"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1.2" />

            <!-- 右列 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/live"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_live"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/liveUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:ellipsize="middle"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="https://" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/liveHome"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_cell_icon"
                        android:duplicateParentState="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_setting_home"
                        android:tint="@color/cell_icon_csl" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/liveHistory"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_cell_icon"
                        android:duplicateParentState="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_setting_history"
                        android:tint="@color/cell_icon_csl" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/player"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_player"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="设置"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/incognito"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_incognito"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/incognitoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="关" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/live_boot"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_live_boot"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/liveBootText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="关" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_search"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/searchText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="横向" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/douban"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="@string/setting_douban"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/doubanText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.5"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp"
                        tools:text="https://" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/restore"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                    android:background="@drawable/selector_cell"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:duplicateParentState="true"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:text="数据恢复"
                        android:textColor="@color/cell_label_csl"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.4"
                        android:duplicateParentState="true"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="@string/setting_restore"
                        android:textColor="@color/cell_value_csl"
                        android:textSize="14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
