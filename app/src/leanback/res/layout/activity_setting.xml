                        tools:text="1.0 MB" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/version"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                        android:layout_marginTop="8dp"
