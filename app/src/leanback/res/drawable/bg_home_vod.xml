<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#338B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#E6A78BFA" android:endColor="#E67C3AED" />
        </shape>
    </item>
    <item android:bottom="24dp" android:left="12dp" android:right="12dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
            <gradient android:angle="270" android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
