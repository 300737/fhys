<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nf_card_btn" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nf_card_btn" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#338B5CF6" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#E6A78BFA"
                        android:endColor="#E67C3AED" />
                </shape>
            </item>
            <item
                android:bottom="24dp"
                android:left="12dp"
                android:right="12dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="13dp"
                        android:topRightRadius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
