<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_15" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/nf_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_15" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/nf_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#E0DDEA" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#E69B68F0"
                android:endColor="#E67C3AED" />
        </shape>
    </item>
</selector>
