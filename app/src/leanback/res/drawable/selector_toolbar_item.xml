<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_15" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/nf_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_15" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/nf_focus" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#338B5CF6" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#E6A78BFA"
                        android:endColor="#E67C3AED" />
                </shape>
            </item>
            <item
                android:bottom="24dp"
                android:left="12dp"
                android:right="12dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
