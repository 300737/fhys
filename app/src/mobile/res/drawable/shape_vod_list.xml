<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 选中 / 按下：中性玻璃底 + 薰衣草发光边（绝不填紫，避免色块压住海报） -->
    <item android:state_selected="true">
        <ripple android:color="#33D9CCFF">
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="8dp" />
                            <solid android:color="#24FFFFFF" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="8dp" />
                            <stroke
                                android:width="1.5dp"
                                android:color="#D9E0D4FF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>

    <!-- 常态：极淡中性玻璃底，卡片里只剩海报本身 + 最外圈薰衣草光边 -->
    <item>
        <ripple android:color="#26D9CCFF">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#12FFFFFF" />
                </shape>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>

</selector>
