<?xml version="1.0" encoding="utf-8"?>
<!-- 星河霓虹：全站页面底（单层平滑纵向渐变，全屏颜色均匀过渡，无叠加光晕避免上下色差） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#2A1C6B"
        android:centerY="0.5"
        android:endColor="#150F30"
        android:startColor="#3B2890"
        android:type="linear" />
</shape>
