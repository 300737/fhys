<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <ripple android:color="#40A855F7">
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="28dp" />
                            <solid android:color="#666D28D9" />
                        </shape>
                    </item>
                    <item
                        android:bottom="1.5dp"
                        android:left="1.5dp"
                        android:right="1.5dp"
                        android:top="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="27dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#D9C4A8FF"
                                android:endColor="#E66D28D9" />
                            <stroke
                                android:width="1.5dp"
                                android:color="#CCE0D4FF" />
                        </shape>
                    </item>
                    <item
                        android:bottom="20dp"
                        android:left="8dp"
                        android:right="8dp"
                        android:top="3dp">
                        <shape android:shape="rectangle">
                            <corners
                                android:bottomLeftRadius="0dp"
                                android:bottomRightRadius="0dp"
                                android:topLeftRadius="16dp"
                                android:topRightRadius="16dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#F2FFFFFF"
                                android:endColor="#00FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple android:color="#26A855F7">
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="28dp" />
                            <solid android:color="#338B5CF6" />
                        </shape>
                    </item>
                    <item
                        android:bottom="1.5dp"
                        android:left="1.5dp"
                        android:right="1.5dp"
                        android:top="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="27dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#BFB79EFF"
                                android:endColor="#B38B5CF6" />
                            <stroke
                                android:width="1.5dp"
                                android:color="#99C9B8FF" />
                        </shape>
                    </item>
                    <item
                        android:bottom="20dp"
                        android:left="8dp"
                        android:right="8dp"
                        android:top="3dp">
                        <shape android:shape="rectangle">
                            <corners
                                android:bottomLeftRadius="0dp"
                                android:bottomRightRadius="0dp"
                                android:topLeftRadius="16dp"
                                android:topRightRadius="16dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#80FFFFFF"
                                android:endColor="#00FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
