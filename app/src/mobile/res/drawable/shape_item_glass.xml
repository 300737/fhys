<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <ripple android:color="#40A855F7">
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="28dp" />
                            <solid android:color="#667C3AED" />
                        </shape>
                    </item>
                    <item
                        android:bottom="1.5dp"
                        android:left="1.5dp"
                        android:right="1.5dp"
                        android:top="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="27dp" />
                            <solid android:color="#FF7C3AED" />
                            <stroke
                                android:width="1.5dp"
                                android:color="#FF7C3AED" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple android:color="#26A855F7">
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="28dp" />
                            <solid android:color="#338B5CF6" />
                        </shape>
                    </item>
                    <item
                        android:bottom="1.5dp"
                        android:left="1.5dp"
                        android:right="1.5dp"
                        android:top="1.5dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="27dp" />
                            <solid android:color="#FF8B5CF6" />
                            <stroke
                                android:width="1.5dp"
                                android:color="#FF8B5CF6" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
