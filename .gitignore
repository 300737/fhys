# ============================================================
#  构建产物 / 本地环境
# ============================================================
*build
build/
buildout/
.gradle/
.idea/
.settings/
.vscode/
*.iml
*.ipr
*.iws
.android-home/
local.properties
/Release

# ============================================================
#  第三方预编译库（不由本仓库维护，CI 通过依赖解析获取）
# ============================================================
*.aar
*.jar
*.so
*.jks
*.keystore
lib-*.aar

# gradle wrapper 的 jar 是构建入口，必须放行
!gradle/wrapper/gradle-wrapper.jar

# app 硬依赖的自研模块预编译包（build.gradle 用 fileTree(libs) 引入），必须放行
!app/libs/*.aar

# media3 fork 自带的 ffmpeg 软解运行时库，打包必需，必须放行
!media/libraries/decoder_ffmpeg/src/main/jniLibs/**/*.so

# ============================================================
#  media3 fork 中与构建无关的大体积内容
# ============================================================
# 上游单元测试的媒体样本（504MB，assemble 用不到）
media/libraries/test_data/
# 上游示例工程（settings.gradle 中已注释，不参与构建）
media/demos/
media/testapps/
media/docsamples/

# ============================================================
#  本地 Maven 仓库（settings.gradle 注册为依赖源，体积小，直接跟踪）
# ============================================================
